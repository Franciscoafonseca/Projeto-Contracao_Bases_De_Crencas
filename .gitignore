@'
# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# PyInstaller / build outputs
build/
ProjetoCrencas/
localpycs/
*.toc
*.pyz
*.pkg
*.manifest
base_library.zip
warn-*.txt
xref-*.html

# Ignorar a pasta dist inteira,
# mas permitir o executável final
dist/*
!dist/ProjetoCrencas/
!dist/ProjetoCrencas/ProjetoCrencas.exe

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# IDE / editor
.vscode/
.idea/
'@ | Set-Content -Encoding UTF8 .gitignore
