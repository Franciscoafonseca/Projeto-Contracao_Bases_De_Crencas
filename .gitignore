@'
# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# PyInstaller / build outputs
build/
ProjetoCrencas/
*.toc
*.pyz
*.pkg
*.manifest
base_library.zip
warn-*.txt
xref-*.html
localpycs/

# Ignorar tudo em dist
dist/*

# Permitir apenas o executável final único
!dist/ProjetoCrencas.exe

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# IDE / editor
.vscode/
.idea/
'@ | Set-Content -Encoding UTF8 .gitignore
